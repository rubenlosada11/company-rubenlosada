# Variables de Docker Compose para PRODUCCIÓN (docker-compose.prod.yml).
# En el VPS se copia a /opt/company-rubenlosada/.env y los secretos se rellenan ALLÍ, nunca en git ni en tu equipo.
# Sin acceso público: los puertos solo escuchan en 127.0.0.1 del VPS y se accede con un túnel SSH
# (puerto local 13000 → website, 13001 → backoffice, 18000 → API).

# --- Imágenes -------------------------------------------------------------------------------------------------------
# Etiqueta de las imágenes trackflow-interfaces / trackflow-backend (hash corto del commit). Para volver a la versión
# anterior, se pone su etiqueta y se repite `up -d`.
IMAGE_TAG=

# --- Navegador → API (PÚBLICAS, solo al COMPILAR la imagen de interfaces en tu equipo) ------------------------------
# Next.js las incrusta en `next build`: cambiarlas en el VPS no tiene efecto sin recompilar.
NEXT_PUBLIC_API_BASE_URL=http://localhost:18000
NEXT_PUBLIC_INVENTORY_API_URL=

# --- API (services/api) ----------------------------------------------------------------------------------------------
# SECRETA. Se genera en el VPS:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Vacía o "change-me" = la API no arranca (a propósito).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SECRETA. Código de invitación para registrarse (≥ 12 caracteres). Se genera igual que SECRET_KEY.
REGISTRATION_CODE=

# Origen del backoffice tal como lo ve el navegador (a través del túnel SSH).
CORS_ALLOWED_ORIGINS=http://localhost:13001,http://127.0.0.1:13001
FRONTEND_BASE_URL=http://localhost:13001

# SECRETA (opcional). Sin clave no se envían emails.
RESEND_API_KEY=
MAIL_FROM=

# SECRETA (opcional). Comentada = SQLite en el volumen trackflow-api-data. Para un proyecto Supabase existente, pega
# su cadena "Session pooler" ENTRE COMILLAS DOBLES (ver docs/inventario.md).
# DATABASE_URL="postgresql+psycopg://postgres.<project-ref>:<contraseña>@<host-del-pooler>:5432/postgres?sslmode=require"
