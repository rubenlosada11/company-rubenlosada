# Variables de Docker Compose para DESARROLLO (docker-compose.yml).
# Primera vez, desde la raíz del repo:  Copy-Item .env.example .env
# Después rellena SECRET_KEY. El .env real está ignorado en git: nunca lo subas.
# Producción usa otra plantilla: env.prod.example.

# --- Puertos publicados en tu equipo (cámbialos si alguno está ocupado) ---------------------------------------------
# Dentro de los contenedores los puertos son fijos: website 3000, backoffice 3001, API 8000.
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
API_PORT=8000

# --- URLs que ve el navegador (PÚBLICAS) -----------------------------------------------------------------------------
# docker-compose.yml las calcula a partir de los puertos de arriba; descoméntalas solo para sobrescribirlas.
# Son URLs que resuelve TU navegador (localhost), no el nombre interno "backend". NEXT_PUBLIC_* van al bundle:
# nunca pongas aquí tokens ni claves.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_INVENTORY_API_URL=           (vacía = misma API que NEXT_PUBLIC_API_BASE_URL)
# CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# FRONTEND_BASE_URL=http://localhost:3001

# Recarga en caliente del frontend. Por defecto webpack con sondeo (Docker Desktop en Windows no propaga los eventos de
# ficheros y Turbopack no ve los cambios). En Linux/macOS puedes usar Turbopack: NEXT_DEV_BUNDLER=turbopack.
# NEXT_DEV_BUNDLER=webpack
# WATCHPACK_POLLING=true

# --- API (services/api) ----------------------------------------------------------------------------------------------
# SECRETA. Clave de firma de los JWT, de al menos 32 caracteres; con "change-me" la API no arranca a propósito.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SECRETA (opcional). Código de invitación para registrarse, de al menos 12 caracteres. Vacío = registro abierto.
REGISTRATION_CODE=

# SECRETA (opcional). Emails de recuperación de contraseña con Resend. Sin clave, la API arranca sin enviar emails.
# MAIL_FROM es obligatoria si hay clave, ENTRE COMILLAS DOBLES:  MAIL_FROM="TrackFlow <no-reply@tu-dominio>"
RESEND_API_KEY=
MAIL_FROM=

# SECRETA (opcional). Base del inventario. Comentada = SQLite en services/api/db/inventory.db (bind mount).
# Para Supabase (Session pooler), ENTRE COMILLAS DOBLES; guía en docs/inventario.md («Conectar Supabase»).
# DATABASE_URL="postgresql+psycopg://postgres.<project-ref>:<contraseña>@<host-del-pooler>:5432/postgres?sslmode=require"
