# Copia este fichero a .env (ignorado en git) y arranca la API con:  uv run --env-file .env uvicorn app.main:app --port 8000
# Nunca subas el .env real ni pongas una clave real aquí.

# Clave de firma de los JWT (HS256), de al menos 32 caracteres. Con "change-me" la API no arranca a propósito.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Minutos de validez de cada token de acceso.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Código de invitación para registrarse (POST /users), de al menos 12 caracteres. Vacío o comentado = registro abierto
# (desarrollo local). Defínelo antes de publicar la API. Genera uno con el mismo comando que SECRET_KEY.
# REGISTRATION_CODE=

# Envío de emails (recuperación de contraseña) con Resend: https://resend.com. Sin RESEND_API_KEY la API arranca, pero
# no envía emails. La clave va SOLO en .env (nunca en git ni en el frontend); basta con permiso "Sending access".
# MAIL_FROM es obligatoria si hay clave y su dominio debe estar verificado en Resend. Escríbela ENTRE COMILLAS DOBLES:
# sin ellas, `uv run --env-file` no entiende el espacio ni el "<" y descarta MAIL_FROM y todas las líneas siguientes.
#   MAIL_FROM="TrackFlow <no-reply@tu-dominio>"
# Sin dominio verificado: MAIL_FROM="TrackFlow <onboarding@resend.dev>" (Resend solo entrega al titular de la cuenta).
RESEND_API_KEY=
MAIL_FROM=

# Opcionales (tienen valor por defecto):
# URL pública del backoffice; el email enlaza a <FRONTEND_BASE_URL>/reset-password?token=...
# FRONTEND_BASE_URL=http://localhost:3002
# Validez de los enlaces de recuperación de contraseña, en minutos (entre 15 y 60).
# RESET_TOKEN_EXPIRE_MINUTES=30
# AUTH_DB_PATH=db/auth.json
# SUPPLIERS_DB_PATH=db/suppliers.json
# CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
