# URL base de la API de TrackFlow (services/api). Arráncala con: cd services\api  →  uv run uvicorn app.main:app --port 8000
# Copia este fichero a .env.local. Next.js incrusta el valor al compilar: reinicia `npm run dev` o repite `npm run build` si lo cambias.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# URL de la API de inventario (/inventory, Hito 5). Hoy es la misma API: si la dejas vacía o la quitas se usa
# NEXT_PUBLIC_API_BASE_URL. Va al navegador (prefijo NEXT_PUBLIC_): nunca pongas aquí tokens, claves ni contraseñas.
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000

# Telemetría (docs/telemetry/telemetry-capture.md): URL completa del receptor de eventos de la API. Sin ella, la
# telemetría queda desactivada (no se captura ni se envía nada). Va al navegador: nunca pongas aquí claves ni tokens.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
# Opcionales: entorno de los eventos (development, test o production; por defecto, según el build) y versión
# desplegada que acompaña a errores y Web Vitals (hash corto del commit; sin valor, "dev").
# NEXT_PUBLIC_TELEMETRY_ENVIRONMENT=development
# NEXT_PUBLIC_APP_VERSION=
