# URL base de la API de TrackFlow (services/api). Arráncala con: cd services\api  →  uv run uvicorn app.main:app --port 8000
# Copia este fichero a .env.local. Next.js incrusta el valor al compilar: reinicia `npm run dev` o repite `npm run build` si lo cambias.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
